# Copied to .env by `make up` / `make up-local`.
#
# Path settings (WAREHOUSE_PATH, LANDING_DIR, DBT_PROJECT_DIR) are NOT set here:
# docker compose sets them to their in-container locations, and local runs fall
# back to repo-relative defaults in pipelines/config.py. Set them yourself only
# if you want the warehouse somewhere else.

# ---- Extract ---------------------------------------------------------------
# Open-Meteo's archive endpoint lags real time by a few days, so a DAG run for
# logical date D extracts weather for (D - ARCHIVE_LAG_DAYS).
ARCHIVE_LAG_DAYS=5

# Seconds to wait on the API before giving up (the task then retries).
REQUEST_TIMEOUT_SECONDS=30

# ---- Airflow ---------------------------------------------------------------
AIRFLOW__CORE__LOAD_EXAMPLES=False
